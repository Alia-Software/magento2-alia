<?xml version="1.0" encoding="UTF-8"?>
<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp:etc/csp_whitelist.xsd">
    <policies>
        <policy id="script-src">
            <values>
                <value id="alia_backend" type="host">backend.alia-prod.com</value>
                <value id="alia_backend_cdn" type="host">backend.alia-cloudflare.com</value>
            </values>
        </policy>
        <policy id="connect-src">
            <values>
                <value id="alia_backend" type="host">backend.alia-prod.com</value>
                <value id="alia_backend_cdn" type="host">backend.alia-cloudflare.com</value>
            </values>
        </policy>
        <policy id="img-src">
            <values>
                <value id="alia_files" type="host">files.alia-prod.com</value>
                <value id="alia_files_cdn" type="host">files.alia-cloudflare.com</value>
                <value id="alia_storage" type="host">storage.googleapis.com</value>
            </values>
        </policy>
        <policy id="media-src">
            <values>
                <value id="alia_files" type="host">files.alia-prod.com</value>
                <value id="alia_files_cdn" type="host">files.alia-cloudflare.com</value>
                <value id="alia_storage" type="host">storage.googleapis.com</value>
            </values>
        </policy>
        <policy id="font-src">
            <values>
                <value id="alia_files" type="host">files.alia-prod.com</value>
                <value id="alia_files_cdn" type="host">files.alia-cloudflare.com</value>
                <value id="alia_storage" type="host">storage.googleapis.com</value>
                <value id="alia_google_fonts" type="host">fonts.gstatic.com</value>
            </values>
        </policy>
        <policy id="style-src">
            <values>
                <value id="alia_google_fonts" type="host">fonts.googleapis.com</value>
            </values>
        </policy>
    </policies>
</csp_whitelist>
