<?php
/**
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\View\Helper\SecureHtmlRenderer $secureRenderer
 */

/** @var \Alia\Connect\ViewModel\Script $viewModel */
$viewModel = $block->getData('view_model');
$src = $viewModel->getSrc();
if ($src === null) {
    return;
}
?>
<?= /* @noEscape */ $secureRenderer->renderTag('script', [
    'src' => $src,
    'async' => 'async',
    'data-page-type' => $viewModel->getPageType(),
], null, false) ?>
