{
  "name": "alia/magento2",
  "description": "Connects a Magento store to Alia for popups, discount codes and revenue reporting.",
  "type": "magento2-module",
  "license": "OSL-3.0",
  "homepage": "https://www.aliapopups.com",
  "require": {
    "php": "~8.1.0||~8.2.0||~8.3.0||~8.4.0||~8.5.0",
    "magento/framework": "^103.0.4",
    "magento/module-cron": "^100.4.4",
    "magento/module-integration": "^100.4.4",
    "magento/module-quote": "^101.2.4",
    "magento/module-sales": "^103.0.4",
    "magento/module-store": "^101.1.4"
  },
  "suggest": {
    "magento/module-csp": "Lets Alia's hosts through the store's content security policy"
  },
  "autoload": {
    "files": [
      "registration.php"
    ],
    "psr-4": {
      "Alia\\Connect\\": ""
    }
  },
  "version": "0.1.0"
}
